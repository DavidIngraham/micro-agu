  "defaults": "# Load AFTER Tools/autotest/default_params/paraglider.parm. SITL research only.\n# Actual HR/TL channel assignments, ranges and reversal.\nSERVO1_FUNCTION 70\nSERVO1_MIN 1000\nSERVO1_MAX 2000\nSERVO1_TRIM 1000\nSERVO1_REVERSED 0\nSERVO2_FUNCTION 0\nSERVO3_FUNCTION 190\nSERVO3_MIN 800\nSERVO3_MAX 2100\nSERVO3_TRIM 800\nSERVO3_REVERSED 0\nSERVO4_FUNCTION 191\nSERVO4_MIN 900\nSERVO4_MAX 2400\nSERVO4_TRIM 2400\nSERVO4_REVERSED 1\nPG_TURN_ENABLE 1\nPG_TURN_P 0.005\nPG_TURN_I 0.0005\nPG_TURN_RDAMP 0.003\nPG_TURN_D_FF 0\nPG_TURN_FILT 1\n# Keep native constant FF; trim-table research is in mission_demo.py.\nPG_TURN_FF 0.051\nTECS_PTCH_DAMP 0\nTHR_MAX 60\nTRIM_THROTTLE 43\n# Voltage-only SITL monitor; JSON backend supplies the physics voltage.\n# No current/discharge model is provided by this research backend.\nBATT_MONITOR 3\nBATT_VOLT_PIN 13\nBATT_VOLT_MULT 10.1\n# Reference matches the existing 22.2 V throttle calibration, not full-charge 6S.\n# Compensation is clamped below 18 V and above 22.2 V; tested at 20.4/22.2 V.\nFWD_BAT_VOLT_MAX 22.2\nFWD_BAT_VOLT_MIN 18\nFWD_BAT_IDX 0\n\n# SITL research candidate. Load after paraglider.parm and sitl.parm.\n# Whole-guidance-loop mission and landing regression: 2026-10-13.\nNAVL1_PERIOD 10\nNAVL1_DAMPING 1.0\nPG_TURN_ENABLE 1\nPG_TURN_FF 0.009\nPG_TURN_P 0.005\nPG_TURN_I 0.002\nPG_TURN_IMAX 0.15\nPG_TURN_ACCEL 40\nPG_TURN_FILT 1\nPG_TURN_TC 0.1\nPG_TURN_ASPD 5\nPG_TURN_RDAMP 0.003\nPG_TURN_D_FF 0\nTECS_PG_ENABLE 1\nTECS_PG_HR_TC 0.5\nTECS_PG_PR_FILT 1.5\nTECS_PG_PR_FILT2 1.5\nTECS_PG_PR_WASH 0\nTECS_PTCH_DAMP 0.1\nTECS_HDEM_TCONST 10\nTECS_CLMB_MAX 1\nTECS_SINK_MAX 2.5\nTECS_SINK_MIN 2.5\nTECS_TIME_CONST 5\nTECS_INTEG_GAIN 0.3\nTECS_VERT_ACC 3.5\nTHR_MAX 60\nTHR_MIN 0\nTHR_SLEWRATE 100\nTRIM_THROTTLE 45\n\n# Match the 22.2 V feedforward calibration; output compensation is native.\nFWD_BAT_VOLT_MAX 22.2\nFWD_BAT_VOLT_MIN 18\nFWD_BAT_IDX 0\n\n# LQI reference shaping; original sensing retained\nCP3_HRTC 0.7\n\n# Qualified browser-only feasible-turn LQI, original K/L and EKF sensing\nCP3_AWMODE 1\nCP3_TMAP 1\nCP3_OBSTRIM 1\n\n# Qualified 35 deg/s browser turn-reference envelope\nCP3_RMAX 35\nPG_TURN_RMAX 35\nCP3_HUP 0.75\nCP3_HDN 1\n"
