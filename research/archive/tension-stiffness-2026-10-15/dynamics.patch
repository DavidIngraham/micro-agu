+ V6 gp=V6::Zero(),gc=V6::Zero();gp.tail<3>()=geom;gc.tail<3>()=-geom;
+ V6 dp=Hpi*gp,dc=Hci*gc;
+ V dJ=A.ldlt().solve(-(Gp*dp-Gc*dc));double dT=-axis.dot(dJ);
